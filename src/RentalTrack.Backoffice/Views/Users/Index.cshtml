@{
    ViewData["Title"] = "Users";
}

<div id="usersApp">
    <h1>Users</h1>
    <p class="subtitle">Browse, search and manage all end users on the platform.</p>

    <div class="card" style="padding: 0;">
        <div class="toolbar">
            <input type="search" v-model="q" @@input="debouncedSearch" placeholder="Search by name or email" class="search" />
            <select v-model="status" @@change="reload">
                <option value="">All statuses</option>
                <option value="active">Active</option>
                <option value="suspended">Suspended</option>
            </select>
            <select v-model="provider" @@change="reload">
                <option value="">All providers</option>
                <option value="google">Google</option>
                <option value="apple">Apple</option>
                <option value="local">Local</option>
            </select>
            <span class="spacer"></span>
            <span class="muted" v-if="total > 0">{{ rangeStart }}–{{ rangeEnd }} of {{ total }}</span>
        </div>

        <div class="table-shell" style="border: none; border-top: 1px solid var(--line-1); border-radius: 0;">
            <table class="dt">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Provider</th>
                        <th>Properties</th>
                        <th>Status</th>
                        <th>Joined</th>
                    </tr>
                </thead>
                <tbody>
                    <tr v-if="loading">
                        <td colspan="6" style="text-align:center; color: var(--fg-3); padding: var(--sp-8) 0;">Loading…</td>
                    </tr>
                    <tr v-else-if="items.length === 0">
                        <td colspan="6" style="text-align:center; color: var(--fg-3); padding: var(--sp-8) 0;">No users match your filters.</td>
                    </tr>
                    <tr v-else v-for="u in items" :key="u.id" @@click="openDetail(u.id)" style="cursor: pointer;">
                        <td>{{ u.displayName }}</td>
                        <td class="mono">{{ u.email }}</td>
                        <td>
                            <span v-if="u.provider" class="pill brand">{{ u.provider }}</span>
                            <span v-else class="pill">—</span>
                        </td>
                        <td class="mono">{{ u.propertyCount }}</td>
                        <td>
                            <span v-if="u.isActive" class="pill success">Active</span>
                            <span v-else class="pill danger">Suspended</span>
                        </td>
                        <td class="mono">{{ formatDate(u.createdAt) }}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="pagination">
            <button class="btn secondary" :disabled="page <= 1" @@click="prev">Prev</button>
            <span class="muted">Page {{ page }} / {{ totalPages }}</span>
            <button class="btn secondary" :disabled="page >= totalPages" @@click="next">Next</button>
        </div>
    </div>

    <transition name="fade">
        <div v-if="detail" class="drawer-scrim" @@click.self="closeDetail">
            <aside class="drawer">
                <header class="drawer-head">
                    <div>
                        <div class="drawer-title">{{ detail.displayName }}</div>
                        <div class="drawer-sub mono">{{ detail.email }}</div>
                    </div>
                    <button class="btn secondary" @@click="closeDetail">Close</button>
                </header>

                <section class="drawer-body">
                    <h3>Account</h3>
                    <dl class="kv-list">
                        <dt>Status</dt>
                        <dd>
                            <span v-if="detail.isActive" class="pill success">Active</span>
                            <span v-else class="pill danger">Suspended</span>
                        </dd>
                        <dt>Provider</dt>
                        <dd>{{ detail.provider || '—' }}</dd>
                        <dt>Joined</dt>
                        <dd class="mono">{{ formatDate(detail.createdAt) }}</dd>
                        <dt>Last sign-in</dt>
                        <dd class="mono">{{ detail.lastLoginAt ? formatDateTime(detail.lastLoginAt) : '—' }}</dd>
                    </dl>

                    <h3 style="margin-top: var(--sp-6);">Properties ({{ detail.properties.length }})</h3>
                    <div v-if="detail.properties.length === 0" class="muted">No properties yet.</div>
                    <table v-else class="dt">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Tenant</th>
                                <th>Monthly rent</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="p in detail.properties" :key="p.id">
                                <td>{{ p.name }}</td>
                                <td>{{ p.tenantName || '—' }}</td>
                                <td class="mono">{{ formatMoney(p.monthlyRentalAmount) }}</td>
                            </tr>
                        </tbody>
                    </table>
                </section>

                <footer class="drawer-foot">
                    <button v-if="detail.isActive" class="btn danger" @@click="suspend" :disabled="suspending">
                        {{ suspending ? 'Suspending…' : 'Suspend account' }}
                    </button>
                    <span v-else class="muted">Account is suspended.</span>
                </footer>
            </aside>
        </div>
    </transition>
</div>

@section Scripts {
    <script>
        (function () {
            const focusId = new URLSearchParams(location.search).get('focus');
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
                || document.querySelector('meta[name="csrf-token"]')?.content;

            const app = Vue.createApp({
                data() {
                    return {
                        items: [], total: 0, page: 1, pageSize: 25,
                        q: '', status: '', provider: '',
                        loading: false,
                        detail: null, suspending: false,
                        debounceHandle: null
                    };
                },
                computed: {
                    totalPages() { return Math.max(1, Math.ceil(this.total / this.pageSize)); },
                    rangeStart() { return this.total === 0 ? 0 : (this.page - 1) * this.pageSize + 1; },
                    rangeEnd() { return Math.min(this.total, this.page * this.pageSize); }
                },
                methods: {
                    async reload() {
                        this.loading = true;
                        try {
                            const params = new URLSearchParams({
                                q: this.q, status: this.status, provider: this.provider,
                                page: this.page, pageSize: this.pageSize
                            });
                            const res = await fetch('/Users/Search?' + params);
                            const data = await res.json();
                            this.items = data.items;
                            this.total = data.total;
                        } finally {
                            this.loading = false;
                        }
                    },
                    debouncedSearch() {
                        clearTimeout(this.debounceHandle);
                        this.debounceHandle = setTimeout(() => { this.page = 1; this.reload(); }, 250);
                    },
                    prev() { if (this.page > 1) { this.page--; this.reload(); } },
                    next() { if (this.page < this.totalPages) { this.page++; this.reload(); } },
                    async openDetail(id) {
                        const res = await fetch('/Users/Detail/' + id);
                        if (!res.ok) return;
                        this.detail = await res.json();
                    },
                    closeDetail() { this.detail = null; },
                    async suspend() {
                        if (!this.detail || !confirm('Suspend ' + this.detail.email + '?')) return;
                        this.suspending = true;
                        try {
                            const fd = new FormData();
                            const res = await fetch('/Users/Suspend/' + this.detail.id, {
                                method: 'POST',
                                headers: token ? { 'RequestVerificationToken': token } : {},
                                body: fd
                            });
                            if (res.ok) {
                                this.detail.isActive = false;
                                await this.reload();
                            }
                        } finally {
                            this.suspending = false;
                        }
                    },
                    formatDate(s) {
                        if (!s) return '—';
                        const d = new Date(s);
                        return String(d.getDate()).padStart(2,'0') + '/' + String(d.getMonth()+1).padStart(2,'0') + '/' + d.getFullYear();
                    },
                    formatDateTime(s) {
                        if (!s) return '—';
                        const d = new Date(s);
                        return this.formatDate(s) + ' ' + String(d.getHours()).padStart(2,'0') + ':' + String(d.getMinutes()).padStart(2,'0');
                    },
                    formatMoney(v) {
                        return 'MYR ' + Number(v).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    }
                },
                mounted() {
                    this.reload().then(() => {
                        if (focusId) this.openDetail(focusId);
                    });
                }
            });
            app.mount('#usersApp');
        })();
    </script>
    <form style="display:none">@Html.AntiForgeryToken()</form>
}
